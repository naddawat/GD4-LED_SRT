<UserControl x:Class="GD4_LED_2.Views.DispenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GD4_LED_2.Views"
             xmlns:converters="clr-namespace:GD4_LED_2.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="800"
             Background="{StaticResource BackgroundGray}">

    <Grid>
        <!-- Loading Overlay -->
        <Border Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="กำลังโหลดข้อมูล..." 
                           Foreground="White" 
                           FontSize="16"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <!-- Search Section -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="ค้นหาใบสั่งยา" 
                                   Style="{StaticResource SubHeaderTextStyle}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Box -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Height="48"
                                     VerticalContentAlignment="Center"
                                     FontSize="14">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Search Button -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SearchCommand}"
                                    Height="48"
                                    Padding="24,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                          Fill="White"
                                          Stretch="Uniform"
                                          Width="16" Height="16"
                                          Margin="0,0,8,0"/>
                                    <TextBlock Text="ค้นหา" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Statistics -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Prescriptions -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ใบสั่งยาทั้งหมด" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding TotalPrescriptions}" 
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Total Items -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="รายการยาทั้งหมด" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding TotalItems}" 
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="สถานะ" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding StatusMessage}" 
                                       Foreground="{StaticResource Success}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Prescription List -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="รายการใบสั่งยา" 
                                       Style="{StaticResource SubHeaderTextStyle}"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="รีเฟรชข้อมูล">
                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                      Fill="{StaticResource PrimaryBlue}"
                                      Stretch="Uniform"
                                      Width="24" Height="24"/>
                            </Button>
                        </Grid>

                        <!-- List -->
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding Prescriptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,12"
                                            BorderBrush="{StaticResource TextSecondary}"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectPrescriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding PrescriptionNo}" 
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding DisplayInfo}" 
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           Margin="0,4,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="Ward: " 
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding Ward}" 
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text=" | Bed: " 
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Bed}" 
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalItems}" 
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBlue}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="รายการ" 
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
