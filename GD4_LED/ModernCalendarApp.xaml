<Window x:Class="GD4_LED.ModernCalendarApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modern Calendar" Height="510" Width="400"
        Background="#F8FAFC" WindowStyle="None">

    <Window.Resources>
        <!-- Modern Color Scheme -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>

        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" Color="#1F2937" BlurRadius="25" ShadowDepth="3" Opacity="0.15"/>

        <!-- Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" 
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="15,0,0,0"/>
                                <Path Grid.Column="1" 
                                      Data="M0,0 L4,4 8,0 Z" 
                                      Fill="{StaticResource TextSecondary}"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,10,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectedDayStyle" BasedOn="{StaticResource DayButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style x:Key="TodayButtonStyle" BasedOn="{StaticResource DayButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Border Background="{StaticResource CardColor}" 
                CornerRadius="12" 
                Effect="{StaticResource CardShadow}"
                Padding="15,0,15,5"
                >

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <TextBlock Text="เลือกวันที่" 
                             Foreground="White" 
                             FontSize="20" 
                             FontWeight="Bold"
                             HorizontalAlignment="Center"/>
                </Border>

                <!-- Year and Month Selection -->
                <Grid Grid.Row="1"  Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Year Selection -->
                    <!--<ComboBox x:Name="CboYear"
                            Grid.Column="0"
                            Style="{StaticResource ModernComboBoxStyle}"
                            Margin="0,0,10,0"
                            SelectionChanged="CboYear_SelectionChanged"/>-->
                    <Border   Grid.Column="0"
        Background="White" 
        CornerRadius="8"
        BorderBrush="{StaticResource TextSecondary}"
        BorderThickness="1"
        Height="48">
                        <Grid>
                            <TextBlock Text="" 
                   Foreground="{StaticResource TextSecondary}"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"/>
                            <ComboBox x:Name="CboYear" 
                  Height="40"
                  BorderThickness="0"
                  FontSize="20"
                  Style="{StaticResource ModernComboBoxStyle}"
                  ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"
                  HorizontalContentAlignment="Left"
                  VerticalContentAlignment="Center"
                                  SelectionChanged="CboYear_SelectionChanged">

                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Month Selection -->

                    <Border  Grid.Column="2"
        Background="White" 
        CornerRadius="8"
        BorderBrush="{StaticResource TextSecondary}"
        BorderThickness="1"
        Height="48">
                        <Grid>
                            <TextBlock Text="" 
                   Foreground="{StaticResource TextSecondary}"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"/>
                            <ComboBox x:Name="CboMonth" 
                  Height="40"
                  BorderThickness="0"
                  FontSize="20"
                  Style="{StaticResource ModernComboBoxStyle}"
                  ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"
                  HorizontalContentAlignment="Left"
                  VerticalContentAlignment="Center"
                                  SelectionChanged="CboMonth_SelectionChanged">

                            </ComboBox>
                        </Grid>
                    </Border>
                    <!--<ComboBox x:Name="CboMonth"
                            Grid.Column="1"
                            Style="{StaticResource ModernComboBoxStyle}"
                            Margin="10,0,0,0"
                            SelectionChanged="CboMonth_SelectionChanged"/>-->

                    <!-- Navigation Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="15,0,0,0">
                        <Button x:Name="BtnPrevMonth" 
                                Content="‹" 
                                Style="{StaticResource ModernButton}"
                                Width="45" 
                                Height="45"
                                Padding="0"
                                FontSize="18"
                                FontWeight="Bold"
                                Click="BtnPrevMonth_Click"/>

                        <Button x:Name="BtnNextMonth" 
                                Content="›" 
                                Style="{StaticResource ModernButton}"
                                Width="45" 
                                Height="45"
                                Padding="0"
                                FontSize="18"
                                FontWeight="Bold"
                                Margin="10,0,0,0"
                                Click="BtnNextMonth_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Current Month Display -->
                <TextBlock x:Name="TxtCurrentMonth" 
                         Grid.Row="2"
                         Text="มกราคม 2024" 
                         Foreground="{StaticResource TextPrimary}"
                         FontSize="16" 
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,5"/>

                <!-- Calendar Area -->
                <Grid Grid.Row="3" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Week Days -->
                    <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,0">
                        <TextBlock Text="อา" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="จ" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="อ" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="พ" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="พฤ" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="ศ" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="ส" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                    </UniformGrid>

                    <!-- Calendar Days -->
                    <UniformGrid x:Name="CalendarGrid" 
                               Grid.Row="1" 
                               Rows="6" 
                               Columns="7"
                               HorizontalAlignment="Center"/>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnToday" 
                            Content="วันนี้" 
                            Style="{StaticResource PrintButtonStyle}"
                            Background="{StaticResource AccentColor}"
                            Margin="0,0,10,0"
                            Click="BtnToday_Click"/>

                    <Button x:Name="BtnConfirm" 
                            Content="ตกลง" 
                            Style="{StaticResource PrintButtonStyle}"
                            Margin="0,0,10,0"
                            Click="BtnConfirm_Click"/>

                    <Button x:Name="BtnCancel" 
                            Content="ยกเลิก" 
                            Style="{StaticResource PrintButtonStyle}"
                            Background="{StaticResource TextSecondary}"
                            Click="BtnCancel_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>