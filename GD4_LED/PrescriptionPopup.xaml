<Window x:Class="GD4_LED.PrescriptionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="รายการจ่ายยา" 
        Height="900" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#cbd5e1" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3b82f6" Offset="0"/>
                                <GradientStop Color="#8b5cf6" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#3b82f6" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header Text Style -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Value Text Style -->
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="24" 
            BorderThickness="3"
            Padding="3">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b82f6" Offset="0"/>
                <GradientStop Color="#8b5cf6" Offset="0.5"/>
                <GradientStop Color="#ec4899" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#3b82f6" BlurRadius="40" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>

        <Border Background="#f8fafc" CornerRadius="21">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <Border Grid.Row="0" 
                    CornerRadius="21,21,0,0" 
                    Padding="30,25">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.05">
                            <GradientStop Color="#3b82f6" Offset="0"/>
                            <GradientStop Color="#8b5cf6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#3b82f6" BlurRadius="15" ShadowDepth="0" Opacity="0.15"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🏥 รายการจ่ายยา" 
                                     FontSize="24" 
                                     FontWeight="Bold" 
                                     Foreground="#1e293b"/>
                                <TextBlock x:Name="txtPrescriptionNo" 
                                     FontSize="14" 
                                     Foreground="#64748b" 
                                     Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Content="✕" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="35" Height="35"
                                FontSize="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#94a3b8"
                                Cursor="Hand"
                                Click="CloseButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#fee2e2"/>
                                                <Setter Property="Foreground" Value="#dc2626"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Patient Info Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="ชื่อผู้ป่วย" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtPatientName" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                <TextBlock Text="HN" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtHN" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>

                            <!-- Row 2 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="AN" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtAN" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
                                <TextBlock Text="Ward" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtWard" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>

                            <!-- Row 3 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="เตียง" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtBed" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="สถานะ" Style="{StaticResource HeaderTextStyle}"/>
                                <Border x:Name="statusBorder" 
                                    Background="#dcfce7" 
                                    CornerRadius="6" 
                                    Padding="12,6"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0">
                                    <TextBlock x:Name="txtStatus" 
                                         FontSize="14" 
                                         FontWeight="Bold" 
                                         Foreground="#16a34a"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Package List Section -->
                <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Padding="30,20"
                         Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="รายการยา" 
                             FontSize="18" 
                             FontWeight="Bold" 
                             Foreground="#1e293b" 
                             Margin="0,0,0,15"/>

                        <ItemsControl x:Name="PackageItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" 
                                        MouseLeftButtonDown="PackageCard_Click"
                                        Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding OrderItemName}" 
                                                     FontSize="16" 
                                                     FontWeight="Bold" 
                                                     Foreground="#1e293b"
                                                     TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding OrderItemCode}" 
                                                     FontSize="13" 
                                                     Foreground="#94a3b8" 
                                                     Margin="0,4,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Background="#eff6ff" 
                                                        CornerRadius="6" 
                                                        Padding="10,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="จำนวน: " 
                                                                 FontSize="13" 
                                                                 Foreground="#3b82f6" 
                                                                 FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding OrderQty}" 
                                                                 FontSize="13" 
                                                                 Foreground="#3b82f6" 
                                                                 FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border x:Name="checkMark" 
                                                Grid.Column="1" 
                                                Width="60" 
                                                Height="60"
                                                CornerRadius="30"
                                                Background="#f1f5f9"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                                <TextBlock Text="✓" 
                                                     FontSize="32" 
                                                     FontWeight="Bold"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" 
                                                     VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" 
                    Background="White" 
                    CornerRadius="0,0,21,21" 
                    Padding="30,20"
                    BorderThickness="0,2,0,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#3b82f6" Offset="0"/>
                            <GradientStop Color="#8b5cf6" Offset="0.5"/>
                            <GradientStop Color="#ec4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="รวมรายการ: " 
                                 FontSize="14" 
                                 Foreground="#64748b" 
                                 VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTotalItems" 
                                 FontSize="16" 
                                 FontWeight="Bold" 
                                 Foreground="#1e293b" 
                                 VerticalAlignment="Center"/>
                            <TextBlock Text=" | เลือกแล้ว: " 
                                 FontSize="14" 
                                 Foreground="#64748b" 
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSelectedItems" 
                                 FontSize="16" 
                                 FontWeight="Bold" 
                                 Foreground="#10b981" 
                                 VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="ยืนยัน" 
                            HorizontalAlignment="Right"
                            Padding="30,12"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ConfirmButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#3b82f6" Offset="0"/>
                                                <GradientStop Color="#2563eb" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#2563eb" Offset="0"/>
                                                        <GradientStop Color="#1d4ed8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>