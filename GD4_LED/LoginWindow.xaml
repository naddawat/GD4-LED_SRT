<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GD4_LED.LoginWindow"
        Title="เข้าสู่ระบบ" 
        Height="700" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Background="White" 
            CornerRadius="24" 
            BorderThickness="3"
            Padding="3">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b82f6" Offset="0"/>
                <GradientStop Color="#8b5cf6" Offset="0.5"/>
                <GradientStop Color="#ec4899" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#3b82f6" BlurRadius="40" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>

        <Border Background="#f8fafc" CornerRadius="21">
            <Grid>
                <Button Content="✕" 
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="35" Height="35"
                        FontSize="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#94a3b8"
                        Cursor="Hand"
                        Margin="15,15,15,0"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#fee2e2"/>
                                    <Setter Property="Foreground" Value="#dc2626"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Margin="50">
                    <Border Background="White"
                            CornerRadius="20"
                            Padding="50,40"
                            BorderThickness="2">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3b82f6" Offset="0"/>
                                <GradientStop Color="#8b5cf6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect Color="#3b82f6" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="🔐" 
                                     FontSize="64" 
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,20"/>

                            <TextBlock Text="เข้าสู่ระบบ" 
                                     FontSize="28" 
                                     FontWeight="Bold" 
                                     Foreground="#1e293b"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="โดยการสแกนบาร์โค้ดหรือคิวอาร์โค้ด" 
                                     FontSize="16" 
                                     Foreground="#64748b"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,30"/>

                            <Border Background="#f1f5f9"
                                    CornerRadius="10"
                                    Padding="20,15"
                                    MinWidth="300">
                                <StackPanel>
                                    <TextBlock x:Name="txtname" Text="รหัสที่สแกน:" 
                                             FontSize="13" 
                                             Foreground="#64748b"
                                             Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtScannedCode" 
                                             Text="รอการสแกน..." 
                                             FontSize="16" 
                                             FontWeight="Bold" 
                                             Foreground="#3b82f6"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             TextAlignment="Center" 
                                             KeyDown="txtScannedCode_KeyDown"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="txtLoginStatus"
                                     Text="" 
                                     FontSize="14" 
                                     Foreground="#dc2626"
                                     HorizontalAlignment="Center"
                                     Margin="0,15,0,0"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
