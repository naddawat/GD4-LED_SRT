<Page x:Class="GD4_LED.page.DispensePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Background="{StaticResource BackgroundGray}">

    <Page.Resources>
        <!-- Loading Animation -->
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingIcon"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                           From="0" To="360" Duration="0:0:2"/>
        </Storyboard>

        <!-- Fade In Animation for Loading -->
        <Storyboard x:Key="FadeInLoading">
            <DoubleAnimation Storyboard.TargetName="LoadingOverlay"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- Slide Up Animation for Main Content -->
        <Storyboard x:Key="SlideUpAnimation">
            <DoubleAnimation Storyboard.TargetName="MainContentTransform"
                           Storyboard.TargetProperty="Y"
                           From="100" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>

        <!-- Fade Out Animation for Loading -->
        <Storyboard x:Key="FadeOutLoading">
            <DoubleAnimation Storyboard.TargetName="LoadingOverlay"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.3"/>
        </Storyboard>
        
        <!-- Card Style for Prescription Detail -->
        <Style x:Key="PrescriptionCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#cbd5e1" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3b82f6" Offset="0"/>
                                <GradientStop Color="#8b5cf6" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#3b82f6" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header Text Style -->
        <Style x:Key="HeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Value Text Style -->
        <Style x:Key="ValueTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid x:Name="MainContent" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainContentTransform" Y="100"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search and Filter Section - Fixed at top -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                                 Text="ค้นหาใบสั่งยา" 
                                 Style="{StaticResource SubHeaderTextStyle}"/>

                    <Grid Grid.Row="2" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search TextBox -->
                        <Border Grid.Column="0" 
                                  Background="White" 
                                  CornerRadius="8"
                                  BorderBrush="{StaticResource TextSecondary}"
                                  BorderThickness="1"
                                  Height="48">
                            <Grid d:IsHidden="True">
                                <TextBlock Text="" 
                                             Foreground="{StaticResource TextSecondary}"
                                             Margin="16,0,0,0"
                                             VerticalAlignment="Center"
                                             x:Name="SearchPlaceholder" d:IsHidden="True"/>
                                <TextBox Background="Transparent"
                                           BorderThickness="0"
                                           FontSize="14"
                                           Padding="16,12"
                                           VerticalAlignment="Center"
                                           x:Name="SearchTextBox"
                                           TextChanged="SearchTextBox_TextChanged"
                                           d:IsHidden="True"
                                           />
                            </Grid>
                        </Border>

                        <!-- Date Picker -->

                        <Button Grid.Column="4" 
                                  Content="⟳ Refresh"
                                FontSize="18"
                                 Style="{StaticResource PrimaryButtonStyle}"
                                  Height="48" Click="SearchButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Summary Statistics - Fixed at top -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!--<ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>-->
                    <!--<ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>-->
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0" d:IsHidden="True">
                    <StackPanel d:IsHidden="True">
                        <TextBlock Text="รอจัด" Style="{StaticResource SecondaryTextStyle}" FontSize="16" FontWeight="Bold" d:IsHidden="True"/>
                        <TextBlock x:Name="PendingCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Warning}" d:IsHidden="True"/>
                    </StackPanel>
                </Border>

                <!--<Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" d:IsHidden="True">
                    <StackPanel d:IsHidden="True">
                        <TextBlock Text="เสร็จแล้ว" Style="{StaticResource SecondaryTextStyle}" FontSize="16" FontWeight="Bold" d:IsHidden="True"/>
                        <TextBlock x:Name="CompletedCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Success}" d:IsHidden="True"/>
                    </StackPanel>
                </Border>-->

                <!--<Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" d:IsHidden="True">
                    <StackPanel d:IsHidden="True">
                        <TextBlock Text="ทั้งหมด" Style="{StaticResource SecondaryTextStyle}" FontSize="16" FontWeight="Bold" d:IsHidden="True"/>
                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" d:IsHidden="True"/>
                    </StackPanel>
                </Border>-->
            </Grid>

            <!-- Scrollable Medicine Cards -->
            <ScrollViewer Grid.Row="2" 
                          VerticalScrollBarVisibility="Auto" 
                          Margin="0,16,0,0"
                          PanningMode="VerticalOnly"
                          IsManipulationEnabled="True"
                          x:Name="MainScrollViewer">
                <StackPanel x:Name="PrescriptionPanel" Focusable="True" d:IsHidden="True">
                    <!-- Cards will be generated here dynamically -->
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#F0F4F8" Opacity="1">
            <Grid.Effect>
                <BlurEffect Radius="0"/>
            </Grid.Effect>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" d:IsHidden="True">
                <!-- Modern Loading Icon -->
                <Border Width="100" Height="100" 
                        Background="White"
                        CornerRadius="20"
                        Margin="0,0,0,32" d:IsHidden="True">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" 
                                        Direction="270" 
                                        ShadowDepth="8" 
                                        Opacity="0.1" 
                                        BlurRadius="20"/>
                    </Border.Effect>

                    <Grid d:IsHidden="True">
                        <!-- Medicine Icon Background -->
                        <Ellipse Width="60" Height="60" 
                                Fill="Transparent"
                                Stroke="#4285F4"
                                StrokeThickness="4"
                                StrokeDashArray="8,4"
                                x:Name="LoadingIcon" d:IsHidden="True">
                            <Ellipse.RenderTransform>
                                <RotateTransform CenterX="30" CenterY="30"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Medicine Icon -->

                        <Path Width="32" Height="32"
                              Fill="#4285F4"
                              Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top" Margin="38,39,0,0" RenderTransformOrigin="0.812,0.196" d:IsHidden="True"/>
                    </Grid>
                </Border>

                <!-- Loading Text -->
                <TextBlock Text="กำลังโหลดข้อมูล..." 
                           FontSize="18"
                           FontWeight="Medium"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" d:IsHidden="True"/>

                <TextBlock Text="โปรดรอสักครู่..." 
                           FontSize="14"
                           Foreground="#7F8C8D"
                           HorizontalAlignment="Center" d:IsHidden="True"/>

                <!-- Progress Dots -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0" d:IsHidden="True">
                    <Ellipse Width="8" Height="8" Fill="#4285F4" Margin="4" d:IsHidden="True">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                       From="0.3" To="1" Duration="0:0:0.6"
                                                       AutoReverse="True"
                                                       BeginTime="0:0:0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Width="8" Height="8" Fill="#4285F4" Margin="4" d:IsHidden="True">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                       From="0.3" To="1" Duration="0:0:0.6"
                                                       AutoReverse="True"
                                                       BeginTime="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Width="8" Height="8" Fill="#4285F4" Margin="4" d:IsHidden="True">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                       From="0.3" To="1" Duration="0:0:0.6"
                                                       AutoReverse="True"
                                                       BeginTime="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </StackPanel>
            </StackPanel>
        </Grid>
        
        <!-- Prescription Detail Overlay -->
        <Grid x:Name="PrescriptionDetailOverlay" Background="#F0FFFFFF" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="White" 
                    CornerRadius="24" 
                    BorderThickness="3"
                    Padding="3"
                    MaxWidth="600"
                    MaxHeight="900"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3b82f6" Offset="0"/>
                        <GradientStop Color="#8b5cf6" Offset="0.5"/>
                        <GradientStop Color="#ec4899" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#3b82f6" BlurRadius="40" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>

                <Border Background="#f8fafc" CornerRadius="21">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Section -->
                        <Border Grid.Row="0" 
                                CornerRadius="21,21,0,0" 
                                Padding="30,25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.05">
                                    <GradientStop Color="#3b82f6" Offset="0"/>
                                    <GradientStop Color="#8b5cf6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#3b82f6" BlurRadius="15" ShadowDepth="0" Opacity="0.15"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title Bar -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="🏥 รายการจ่ายยา" 
                                                   FontSize="24" 
                                                   FontWeight="Bold" 
                                                   Foreground="#1e293b"/>
                                        <TextBlock x:Name="txtPrescriptionNo" 
                                                   Text="เลขที่ใบสั่งยา" 
                                                   FontSize="14" 
                                                   Foreground="#64748b" 
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Content="✕" 
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="35" Height="35"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#94a3b8"
                                            Cursor="Hand"
                                            Click="ClosePrescriptionButton_Click">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#fee2e2"/>
                                                        <Setter Property="Foreground" Value="#dc2626"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Patient Info Grid -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 1 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                        <TextBlock Text="HN" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock x:Name="txtHN" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                        <TextBlock Text="AN" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock x:Name="txtAN" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>

                                    <!-- Row 2 -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                                        <TextBlock Text="ชื่อผู้ป่วย" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock x:Name="txtPatientName" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
                                        <TextBlock Text="Ward" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock x:Name="txtWard" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>

                                    <!-- Row 3 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Bed" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock x:Name="txtBed" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Package List Section -->
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="30,20"
                                      Margin="0,10,0,0"
                                      PanningMode="VerticalOnly"
                                      IsManipulationEnabled="True">
                            <StackPanel>
                                <TextBlock Text="รายการยา" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#1e293b" 
                                           Margin="0,0,0,15"/>

                                <ItemsControl x:Name="PackageItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PrescriptionCardStyle}" 
                                                    MouseLeftButtonDown="PackageCard_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Header with Code -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding OrderItemCode}" 
                                                                       FontSize="13" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="#3b82f6"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Medicine Name -->
                                                    <TextBlock Grid.Row="1" 
                                                               Text="{Binding OrderItemName}" 
                                                               FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="#1e293b" 
                                                               TextWrapping="Wrap" 
                                                               Margin="0,0,0,12"/>

                                                    <!-- Info Grid -->
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Quantity -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="จำนวน: " 
                                                                       FontSize="14" 
                                                                       Foreground="#64748b"/>
                                                            <TextBlock Text="{Binding OrderQty}" 
                                                                       FontSize="14" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#f59e0b"/>
                                                        </StackPanel>

                                                        <!-- Location -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="📍 " FontSize="14"/>
                                                            <TextBlock Text="{Binding Location}" 
                                                                       FontSize="13" 
                                                                       Foreground="#64748b"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Check Mark -->
                                                    <Border x:Name="CheckMark"
                                                            Grid.Row="0" Grid.RowSpan="3"
                                                            Width="50" Height="50"
                                                            Background="#10b981"
                                                            CornerRadius="25"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-10,-10,0"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="✓" 
                                                                   FontSize="28" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" 
                                Background="White" 
                                CornerRadius="0,0,21,21" 
                                Padding="30,20"
                                BorderThickness="0,2,0,0">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3b82f6" Offset="0"/>
                                    <GradientStop Color="#8b5cf6" Offset="0.5"/>
                                    <GradientStop Color="#ec4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="รวมรายการ: " 
                                               FontSize="16" 
                                               Foreground="#64748b" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalItems"
                                               Text="0"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#3b82f6"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" | จัดแล้ว: " 
                                               FontSize="16" 
                                               Foreground="#64748b"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtSelectedItems" 
                                               Text="0"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#10b981"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Content="ยืนยัน" 
                                        HorizontalAlignment="Right"
                                        Padding="30,12"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ConfirmButton_Click">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#3b82f6" Offset="0"/>
                                                        <GradientStop Color="#8b5cf6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="8" 
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#2563eb" Offset="0"/>
                                                                <GradientStop Color="#7c3aed" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#3b82f6" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>

    </Grid>
</Page>